# Copia este archivo como ".env" (sin ".example") y rellena tus valores reales.
# NUNCA subas el archivo ".env" real a un repositorio público ni lo compartas.

# --- Discord OAuth2 (créala en https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=tu_client_id
DISCORD_CLIENT_SECRET=tu_client_secret
# Debe coincidir EXACTAMENTE con la que registres en el panel de Discord Developer.
DISCORD_REDIRECT_URI=https://tuweb.com/auth/discord/callback

# --- Bot de Discord (necesario para comprobar roles del usuario) ---
# El bot debe estar en tu servidor de Discord. No necesita permisos de administrador,
# solo estar presente en el guild para poder leer sus miembros.
DISCORD_BOT_TOKEN=tu_bot_token

# --- Servidor y rol que da acceso al panel ---
DISCORD_GUILD_ID=id_de_tu_servidor_discord
DISCORD_REQUIRED_ROLE_ID=id_del_rol_que_da_acceso

# --- Sesión ---
# Genera una cadena aleatoria larga, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_algo_aleatorio_y_largo

# --- Puerto en el que escucha el servidor ---
PORT=3000

# Pon esto en "true" solo cuando sirvas la web por HTTPS real (necesario para cookies seguras)
COOKIE_SECURE=false
